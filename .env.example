# Merge missing settings into your existing .env; do not overwrite your keys.
OPENROUTER_API_KEY=
# Existing open_router= is also accepted.
OPENROUTER_MODEL=openrouter/free

MUNSIT_API_KEY=
# Existing key= is accepted as a legacy alias for MUNSIT_API_KEY.
# Munsit speech consumes credits (free/trial credits included). Set false to
# block all speech requests, e.g. when your balance is low.
ENABLE_MUNSIT_BILLING=true
MUNSIT_API_MODE=current
MUNSIT_STT_MODEL=munsit-en-ar
# Mansour: Munsit-curated Emirati male voice, Arabic + English, calm and clear.
# Same ID as: python -m examples.munsit_transcribe --select-voice Mansour
# Browse others with: python -m examples.munsit_transcribe --voices
MUNSIT_VOICE_ID=oO8zgqKEMS0jmF8LvKr8MmEL
MUNSIT_TTS_MODEL=faseeh-v1-preview

# Needed for room-based examples; not for direct text chat or console voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=tutorial-room

# Advanced desk: add Munsit speech (needs ENABLE_MUNSIT_BILLING=true).
ADVANCED_AGENT_VOICE=false
# Opt in to behavioural tests that call the free LLM.
RUN_LIVE_LLM_TESTS=0

